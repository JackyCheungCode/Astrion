{
  "name": "astrion",
  "compatibility_date": "2026-10-24",
  "previews": {},
  "build": {
    "command": "npm install --prefix apps/web --no-audit --no-fund && npm run build --prefix apps/web"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
